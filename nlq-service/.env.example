# DeepSeek API（deepseek-flash：NL2SQL / Agent 与图片识图共用同一模型与端点）
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=15

# 识图回退开关：默认 deepseek（与上面同通道，无需额外 key）；
# 仅当统一通道异常时临时改为 zhipu，切到智谱 GLM-4V 需同时填 ZHIPU_API_KEY，
# 且只保留一个发布周期（切换后智谱调用量应归 0）。
VISION_PROVIDER=deepseek
ZHIPU_API_KEY=
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_VISION_MODEL=glm-4v-flash

# NL2SQL 专用只读数据库账号
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ltpms_db
DB_USER=ltpms_readonly
DB_PASSWORD=readonly_password

# 服务间鉴权令牌（与 Java 后端一致）
NLQ_INTERNAL_TOKEN=your_internal_token_here

# DashScope 文本向量化（知识库检索；key 为空时知识库能力优雅降级）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# 服务配置
HOST=0.0.0.0
PORT=8001

# MCP Server（V3 只读数据工具）：生产环境建议 MCP_ENABLED=false
MCP_ENABLED=true
MCP_HOST=127.0.0.1
MCP_PORT=8800
MCP_TOKEN=
MCP_MAX_ROWS=100
