# DeepSeek API
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=15

# NL2SQL 专用只读数据库账号
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ltpms_db
DB_USER=ltpms_readonly
DB_PASSWORD=readonly_password

# 服务间鉴权令牌（与 Java 后端一致）
NLQ_INTERNAL_TOKEN=your_internal_token_here

# DashScope 文本向量化（知识库检索；key 为空时知识库能力优雅降级）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# 服务配置
HOST=0.0.0.0
PORT=8001

# MCP Server（V3 只读数据工具）：生产环境建议 MCP_ENABLED=false
MCP_ENABLED=true
MCP_HOST=127.0.0.1
MCP_PORT=8800
MCP_TOKEN=
MCP_MAX_ROWS=100
